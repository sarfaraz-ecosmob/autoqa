# --- Build args (defaults suit local dev; override in .env) ---
PYTHON_VERSION=3.11-slim
NODE_VERSION=20-alpine

# --- Compose project name ---
COMPOSE_PROJECT_NAME=autoqa

# --- Postgres (Phase 1+) ---
POSTGRES_USER=autoqa
POSTGRES_PASSWORD=autoqa_dev_password
POSTGRES_DB=autoqa

# --- Backend ---
AUTOQA_ENVIRONMENT=development
AUTOQA_SECRET_KEY=dev_only_change_me_NOT_FOR_PRODUCTION_USE
AUTOQA_REDIS_URL=redis://redis:6379/0
AUTOQA_DATABASE_URL=postgresql+psycopg://autoqa:autoqa_dev_password@postgres:5432/autoqa

# --- Object storage (Phase 1+) ---
AUTOQA_MINIO_ENDPOINT=minio:9000
AUTOQA_MINIO_ACCESS_KEY=autoqa
AUTOQA_MINIO_SECRET_KEY=autoqa_dev_password
AUTOQA_MINIO_BUCKET=autoqa-artifacts
MINIO_ROOT_USER=autoqa
MINIO_ROOT_PASSWORD=autoqa_dev_password

# --- Demo target app (Phase 2+) ---
DEMO_APP_PORT=9000
